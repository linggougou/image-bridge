{
  "name": "image-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Gemini, ChatGPT Web, and normal-Chrome extension image bridge for Multica.",
  "bin": {
    "image-bridge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bridge": "node dist/cli.js bridge",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
